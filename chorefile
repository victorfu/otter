require 1.6.0

# Otter development tasks. Run `chore list` to see them.
#
# The desktop loop and the sidecar fetch live here; tasks that belong to one
# area live with it, as `<area>/<area>.chore`, and are included below. They
# are deliberately not named `chorefile`: chore resolves a run by walking up
# for that filename, so included tasks always share the same repository root.
#
# The Python scripts under scripts/ are still the programs they always were --
# these tasks call them, they do not reimplement them. CI calls the same tasks,
# so a green local run means the same commands ran.

include website/website.chore
include e2e/e2e.chore

bin=desktop/src-tauri/binaries
# The GitHub repository that hosts Otter's prebuilt sidecar inputs as release assets.
repo=victorfu/otter
# FFmpeg ships inside the app and runs on every file a user opens. The upstream
# archives are mirrored unchanged into this release (upload-ffmpeg), so each hash
# below is also the one upstream publishes: osxexperts names its zips by version
# (80 = 8.0), and the Windows build is gyan.dev's versioned release. A new FFmpeg
# goes in a new tag, so the archives an older commit pins never change under it.
ffmpeg_tag=ffmpeg-r1
ffmpeg_darwin_arm64=ffmpeg80arm.zip
ffmpeg_darwin_arm64_sum=0d4efcaf6a098430a708e0af694a84792938921fa126162787ae98c6151d7a95
ffmpeg_darwin_x86_64=ffmpeg80intel.zip
ffmpeg_darwin_x86_64_sum=2d24d22db78c87f394a5822867acd5c5dc5e762cd261a44bd26923f3a5af3e07
ffmpeg_windows=ffmpeg-9.0.2-essentials_build.zip
ffmpeg_windows_sum=60f467265b1e312373dbcd92200c2618a74850f98d3d078e94296bb3fa2047ba
# Model files the app downloads at runtime, copied unchanged into this release
# (upload-models). website/public/models.json points the app at the copy and pins
# the same size and hash, so keep the two in step.
models_tag=models-r1
diarize_model=nemotron-3-diarization-Q8_0.gguf
diarize_model_source=https://huggingface.co/otter-app/nemotron-3-diarization-gguf/resolve/main/$diarize_model
diarize_model_sum=a25f026847d765c8661fd5095c73a0e5f20d310dcb8249c654e3828592a2fc73
# The GitHub-hosted mirror of the default Whisper model, beside its Hugging Face addresses.
turbo_model=ggml-large-v3-turbo.bin
turbo_model_source=https://huggingface.co/ggerganov/whisper.cpp/resolve/main/$turbo_model
turbo_model_sum=1fc70f774d38eb169993ac391eea357ef47c88757ef72ee5943879b7e8e2bc69
# Tauri's GStreamer plugin release, a tag of tauri-apps/tauri-gstreamer-plugin.
gst_plugin=gst-plugin-tauri-v0.0.1

# The distributed Chore binary can be built for musl even on a glibc host.
# Rust determines both the native Cargo target and Tauri's sidecar suffix.
rust_host=$(rustc --print host-tuple)

# Compile the engine from the same checkout as the desktop client.
task server-build target=$rust_host {
    exe=""
    if $1 == aarch64-apple-darwin {
        platform=darwin-arm64
    } else if $1 == x86_64-apple-darwin {
        platform=darwin-x86_64
    } else if $1 == x86_64-pc-windows-msvc {
        platform=windows-amd64-msvc
    } else if $1 == x86_64-unknown-linux-gnu {
        platform=linux-x86_64
    } else if $1 == aarch64-unknown-linux-gnu {
        platform=linux-aarch64
    } else {
        fail "unsupported target: $1"
    }
    if $1 contains windows { exe=.exe }
    cd server
    version=$(read libs/ggml-version)
    revision=$(read libs/revision)
    tag=libraries-ggml-$version-r$revision
    if !exists libs/lib/$platform-$tag {
        chore fetch-libs $platform
        echo "$tag" > libs/lib/$platform-$tag
    }
    if $1 == $rust_host {
        cargo build --locked --release -p otter-server
        binary=server/target/release/otter-server$exe
    } else {
        cargo build --locked --release --target $1 -p otter-server
        binary=server/target/$1/release/otter-server$exe
    }
    cd $ROOT
    mkdir $bin
    copy $binary $bin/otter-server-$1$exe
}

task setup target=$rust_host {
    server-build $1
    if $1 contains linux {
        gst-plugin $1
        return
    }
    exe=""
    if $1 contains windows { exe=.exe }
    if exists $bin/ffmpeg-$1$exe { return }
    if $1 == aarch64-apple-darwin {
        asset=$ffmpeg_darwin_arm64
        sum=$ffmpeg_darwin_arm64_sum
    } else if $1 == x86_64-apple-darwin {
        asset=$ffmpeg_darwin_x86_64
        sum=$ffmpeg_darwin_x86_64_sum
    } else if $1 == x86_64-pc-windows-msvc {
        asset=$ffmpeg_windows
        sum=$ffmpeg_windows_sum
    } else {
        fail "no FFmpeg is pinned for $1"
    }
    stage=target/sidecars
    remove $stage
    mkdir $stage
    download gh://$repo/$ffmpeg_tag/$asset $stage/$asset --timeout 180 --sha256 $sum
    # The macOS zips hold ffmpeg at the root; gyan.dev's holds <name>/bin/ffmpeg.exe.
    if $1 contains windows {
        extract $stage/$asset $stage --member ffmpeg.exe --strip 2
    } else {
        extract $stage/$asset $stage --member ffmpeg
    }
    move $stage/ffmpeg$exe $bin/ffmpeg-$1$exe
    chmod 755 $bin/ffmpeg-$1$exe
    remove $stage
}

# Mirror the pinned upstream FFmpeg archives, unchanged, into the $ffmpeg_tag release.
# CI runs it from .github/workflows/ffmpeg-mirror.yml.
task upload-ffmpeg {
    stage=target/ffmpeg-mirror
    remove $stage
    mkdir $stage
    download https://www.osxexperts.net/$ffmpeg_darwin_arm64 $stage/$ffmpeg_darwin_arm64 --timeout 180 --sha256 $ffmpeg_darwin_arm64_sum
    download https://www.osxexperts.net/$ffmpeg_darwin_x86_64 $stage/$ffmpeg_darwin_x86_64 --timeout 180 --sha256 $ffmpeg_darwin_x86_64_sum
    download gh://GyanD/codexffmpeg/9.0.2/$ffmpeg_windows $stage/$ffmpeg_windows --timeout 180 --sha256 $ffmpeg_windows_sum
    # A prerelease: the website ships whichever release is marked latest (docs/UPDATER.md).
    try gh release create $ffmpeg_tag --repo $repo --prerelease --title "FFmpeg sidecars ($ffmpeg_tag)" --notes "Unchanged mirrors of the FFmpeg builds Otter bundles. macOS: FFmpeg 8.0 from https://www.osxexperts.net. Windows: FFmpeg 9.0.2 essentials from https://www.gyan.dev/ffmpeg/builds/ (GitHub mirror GyanD/codexffmpeg). SHA-256 digests are pinned in the chorefile and equal the ones upstream publishes."
    gh release upload $ffmpeg_tag $stage/$ffmpeg_darwin_arm64 $stage/$ffmpeg_darwin_x86_64 $stage/$ffmpeg_windows --repo $repo --clobber
    remove $stage
    echo "uploaded FFmpeg archives to release $ffmpeg_tag"
}

# Copy the runtime model files, unchanged, into the $models_tag release.
# CI runs it from .github/workflows/models-mirror.yml.
task upload-models {
    stage=target/models-mirror
    remove $stage
    mkdir $stage
    download $diarize_model_source $stage/$diarize_model --timeout 600 --sha256 $diarize_model_sum
    download $turbo_model_source $stage/$turbo_model --timeout 1800 --sha256 $turbo_model_sum
    # A prerelease: the website ships whichever release is marked latest (docs/UPDATER.md).
    notes="Unchanged copies of model files the Otter app downloads on demand. SHA-256 digests are pinned in the chorefile and website/public/models.json. $diarize_model: NVIDIA Nemotron-3-Diarization (https://huggingface.co/nvidia/Nemotron-3-Diarization), licensed under OpenMDW 1.1, converted to GGUF Q8_0 by server/crates/nemotron-diarize-rs/scripts/export.py and first published at $diarize_model_source. $turbo_model: OpenAI Whisper large-v3-turbo (MIT) in whisper.cpp GGML format, from $turbo_model_source."
    try gh release create $models_tag --repo $repo --prerelease --title "Runtime models ($models_tag)" --notes "$notes"
    # The release may predate a file added here; keep its notes describing every asset.
    gh release edit $models_tag --repo $repo --notes "$notes"
    gh release upload $models_tag $stage/$diarize_model $stage/$turbo_model --repo $repo --clobber
    remove $stage
    echo "uploaded runtime models to release $models_tag"
}

# Fetch Tauri's GStreamer plugin for asset:// playback into the Linux packages: gst-plugin <triple>.
task gst-plugin target=$rust_host {
    # WebKitGTK plays media through GStreamer, which cannot read the asset:// URLs the
    # player uses (#1711). tauri.linux.conf.json packages this file and linux_media.rs
    # points GStreamer at it. Pinned by hash: it is loaded into the app's web process.
    out=desktop/src-tauri/gstreamer
    if exists $out/libgsttauriasset.so {
        echo "the GStreamer plugin is already in place"
        return
    }
    if $1 == x86_64-unknown-linux-gnu {
        asset=libgsttauriasset-x86_64.so
        sum=abb55c037ac07545c0e19e8d11fbc6bc642c23a24f35f550b5f830d387db0914
    } else if $1 == aarch64-unknown-linux-gnu {
        asset=libgsttauriasset-aarch64.so
        sum=a50347365b0949a3bd251689b7b5e1cbb01b4ae9a2e3446d6d28a77d55b35f6f
    } else {
        fail "the GStreamer plugin has no build for $1"
    }
    mkdir $out
    download gh://tauri-apps/tauri-gstreamer-plugin/$gst_plugin/$asset $out/libgsttauriasset.so --sha256 $sum
    echo "installed the GStreamer plugin for $1"
}

# Install the Linux build dependencies with apt.
task linux-deps {
    # The Tauri prerequisites plus what Otter adds on top: alsa for audio, xdo
    # for the global shortcut, and the appindicator bindings for the tray icon.
    # `setup` deliberately does not call this -- it needs sudo, and every
    # `chore dev` should not ask for a password.
    if $OS != linux {
        fail "linux-deps is for Linux; there is nothing to install on $OS"
    }
    sudo apt-get update
    sudo apt-get install -y pkg-config build-essential libglib2.0-dev libgtk-3-dev libwebkit2gtk-4.1-dev clang cmake libssl-dev libasound2-dev libxdo-dev libayatana-appindicator3-dev
}

# Install the frontend dependencies.
task install {
    cd desktop
    pnpm install
}

# Run the app in dev mode.
task dev {
    setup
    cd desktop
    pnpm exec tauri dev
}

# Run only the desktop frontend in a browser, with Tauri mocked.
task dev-web {
    cd desktop
    pnpm dev
}

# Build the app for production.
task build {
    setup
    cd desktop
    pnpm exec tauri build
}

# Rebuild otter.app, replace the installed one and relaunch it (macOS).
task upgrade {
    # The updater artifacts are skipped: signing them needs the CI private key.
    setup
    cd desktop
    pnpm exec tauri build --bundles app --config '{"bundle":{"createUpdaterArtifacts":false}}'
    cd $ROOT
    try osascript -e 'quit app "otter"'
    remove /Applications/Otter.app
    copy target/release/bundle/macos/Otter.app /Applications/Otter.app
    open /Applications/Otter.app
    echo "otter upgraded and relaunched"
}

# Run the frontend tests.
task test {
    cd desktop
    pnpm test
}

# Lint the frontend and Rust, with the flags CI uses.
task lint {
    cd desktop
    pnpm lint
    cd $ROOT
    # These match .github/workflows/lint_rust.yml exactly. The justfile's
    # versions had drifted -- no --all, no --all-targets, no -D warnings --
    # so a clean `just lint` said nothing about whether CI would pass.
    cargo fmt --manifest-path Cargo.toml --all -- --check
    cargo clippy --manifest-path Cargo.toml --all-targets -- -D warnings
}

# Format everything in place.
task format {
    npm run format
}

# Regenerate the i18n files.
task i18n {
    cd desktop
    pnpm i18n:generate
}

# Check translation coverage against en-US.
task check-i18n {
    uv run scripts/check_i18n.py
}

# Refresh the source hash on every translated changelog entry and docs page.
task stamp-translations {
    uv run scripts/content_i18n.py stamp
}

# Type-check the desktop app and the website.
task check-types {
    npm run check-types
}

# Run every check CI runs, in one go.
task ci {
    lint
    check-types
    check-i18n
    test
}
