{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "floating-dock",
	"description": "Floating dock: drag the window, read settings, send actions to the main window",
	"local": true,
	"windows": ["floating-dock"],
	"permissions": [
		"core:event:default",
		"core:path:default",
		"core:window:default",
		"core:window:allow-start-dragging",
		"core:webview:default",
		"os:allow-locale",
		"os:allow-platform",
		"store:default"
	]
}
