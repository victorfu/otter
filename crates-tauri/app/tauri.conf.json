{
  "$schema": "../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Otter Dev",
  "version": "0.1.0",
  "identifier": "cc.otter.dev",
  "build": {
    "beforeDevCommand": "npm run dev -w @otter/client",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build -w @otter/client",
    "frontendDist": "../../apps/client/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Otter Dev",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "category": "Utility",
    "publisher": "Example Inc.",
    "homepage": "https://example.com",
    "copyright": "© Example Inc.",
    "shortDescription": "A cross-platform desktop app built with Tauri.",
    "longDescription": "A cross-platform desktop app built with Tauri.",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
