# Copy to .env (git-ignored) and fill in. Only needed for release bundles.
# Every value is optional: missing values produce an unsigned build with a warning.

# --- Updater signing (npm run updater:keygen fills these in) ------------------
# Path to the private key OUTSIDE the repo, or the key contents themselves.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Base URL where release assets are downloadable; used by make-latest-json.
# {version} is replaced with the app version.
UPDATER_DOWNLOAD_BASE_URL=https://github.com/OWNER/REPO/releases/download/v{version}

# --- macOS code signing & notarization -----------------------------------------
# base64 of the exported .p12 "Developer ID Application" certificate
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
# e.g. "Developer ID Application: Example Inc. (TEAMID1234)"
APPLE_SIGNING_IDENTITY=
# Notarization (Apple ID + app-specific password)
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# --- Windows code signing (pick one) --------------------------------------------
# A) Certificate installed in the Windows certificate store
WINDOWS_CERTIFICATE_THUMBPRINT=
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
# B) Azure Trusted Signing (requires `cargo install trusted-signing-cli`)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_TRUSTED_SIGNING_ENDPOINT=
AZURE_TRUSTED_SIGNING_ACCOUNT=
AZURE_TRUSTED_SIGNING_PROFILE=
